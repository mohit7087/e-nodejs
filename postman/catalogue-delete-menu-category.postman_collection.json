{
  "info": {
    "name": "Catalogue - Delete Menu Category",
    "description": "Soft-deactivates a menu category. The request is rejected when active direct child categories exist.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "categoryId",
      "value": "replace-with-category-object-id"
    }
  ],
  "item": [
    {
      "name": "Deactivate Menu Category",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/deleteMenuCategory/{{categoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "deleteMenuCategory",
            "{{categoryId}}"
          ]
        },
        "description": "Sets the category status to inactive without deleting the MongoDB document."
      },
      "response": []
    }
  ]
}
